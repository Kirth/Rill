let rows = [{host: "b", up: true, load: 2}, {host: "a", up: false, load: 5}, {host: "c", up: true, load: 1}]
print(rows.sort_by(.load).map(.host).join(","))
print(rows.sort_by(.host).reverse().map(.host).join(","))
print(rows.count(.up), rows.all(.up), rows.map(.load).sum())
let by_host = rows.index_by(.host)
print(by_host.a.load, by_host.keys().join(","))
print([3, 1, 3, 2, 1].unique().join(","))
