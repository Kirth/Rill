let m = {zeta: 1, alpha: 2, mid: 3}
print(m.keys())
for (k, v) in m { print "{k}={v}" }
print(m.entries())
let xs = [3, 1, 2]
print(xs.sort(), xs.reverse(), xs.len())
print(xs.first(), [].first(), xs.last(), xs.get(1), xs.get(9))
print([1, 2, 3].zip(["a", "b", "c"]))
print(xs[1..], xs[..2], xs[0..=1], xs[-2..], "hello"[1..3])
print((0..10).step(3), (1..=4).len())
print(2 in xs, 5 not in xs, "alpha" in m, "ell" in "hello")
print([[1, 2], [3]].flatten(), xs.filter(|x| x > 1), xs.find(|x| x > 1), xs.any(|x| x > 2))
var ys = []
for i in 0..5 { ys += [i * i] }
print(ys, ys.take(2), ys.join(","))
