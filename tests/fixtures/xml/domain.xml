<?xml version="1.0" encoding="UTF-8"?>
<!-- An invented libvirt domain for the XML tests. -->
<domain type="kvm" xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0">
  <name>vm1</name>
  <uuid>4dea22b3-1d52-d8f3-2516-782e98ab3fa0</uuid>
  <memory unit="KiB">4194304</memory>
  <vcpu placement="static">2</vcpu>
  <metadata>
    <note><![CDATA[uses <virtio> & friends]]></note>
  </metadata>
  <os>
    <type arch="x86_64" machine="pc-q35-8.2">hvm</type>
    <boot dev="hd"/>
  </os>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <source file="/var/lib/libvirt/images/vm1.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/var/lib/libvirt/images/installer.iso"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
    <interface type="bridge">
      <mac address="52:54:00:aa:bb:01"/>
      <source bridge="br0"/>
      <model type="virtio"/>
    </interface>
    <interface type="network">
      <mac address="52:54:00:aa:bb:02"/>
      <source network="default"/>
      <model type="e1000"/>
    </interface>
    <graphics type="vnc" port="5901" autoport="no" listen="127.0.0.1"/>
  </devices>
  <qemu:commandline>
    <qemu:arg value="-s"/>
  </qemu:commandline>
</domain>
